{
  "name": "mami-pan-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "html_handling": "none"
  },
  "routes": [
    { "pattern": "mamipan.cl", "custom_domain": true }
  ],
  "workers_dev": true
}
